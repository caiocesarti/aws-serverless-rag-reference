# =============================================================================
# ImobiSmart AI — Template de Variáveis de Ambiente (SEM SEGREDOS REAIS)
# Copie para .env.local (em apps/web/) ou configure no SAM/Lambda e Vercel.
# =============================================================================

# --- AWS Backend (Lambda / SAM) ---
AWS_REGION=us-east-1
KNOWLEDGE_BASE_ID=REPLACE_WITH_BEDROCK_KB_ID
MODEL_ARN=arn:aws:bedrock:us-east-1:REPLACE_ACCOUNT_ID:inference-profile/us.amazon.nova-pro-v1:0
RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0
GUARDRAIL_ID=REPLACE_WITH_GUARDRAIL_ID
GUARDRAIL_VERSION=DRAFT
DOCS_BUCKET_NAME=imobismart-kb-docs-REPLACE_ACCOUNT_ID
DOCS_PREFIX=documents/
SESSIONS_TABLE_NAME=imobismart-sessions
PRESIGNED_URL_EXPIRES_SECONDS=600
LOG_LEVEL=INFO

# --- Frontend BFF (Vercel / apps/web/.env.local — Server-only) ---
AWS_API_BASE_URL=https://REPLACE_API_ID.execute-api.us-east-1.amazonaws.com/prod
AWS_API_KEY=REPLACE_WITH_API_GATEWAY_USAGE_PLAN_KEY
ALLOWED_ORIGINS=http://localhost:3000,https://REPLACE_YOUR_APP.vercel.app
RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60
